#frontend
FRONTEND_URL=FRONTEND_URL
# Optionnel : origines CORS séparées par des virgules ; défaut = FRONTEND_URL
CORS_ORIGINS=

#Provider_keys
MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY
TOGETHER_API_KEY=YOUR_TOGETHER_API_KEY
RESEND_API_KEY=RESEND_API_KEY

#Auth
EMAIL="What's On Meeting <login@scribeapp.online>"
SECRET_KEY=YOUR_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=TIMER_TO_SET

#Database
DATABASE_URL=YOUR_DATABASE_URL

#Models
SPEECH_TO_TEXT_MODEL="YOUR_STT_MODEL"
CLASSIFIER_MODEL="YOUR_CLASSIFIER_MODEL"

#Calendar bot (Google Calendar + MeetingBaaS)
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
# Optionnel : sinon déduit de la requête (<BACKEND_URL>/calendar/oauth/callback)
GOOGLE_OAUTH_REDIRECT_URI=
MEETING_BAAS_API_KEY=YOUR_MEETING_BAAS_API_KEY
MEETING_BAAS_WEBHOOK_SECRET=whsec_...
# Optionnel : URL publique du webhook envoyée à MeetingBaaS (<BACKEND_URL>/calendar/webhook)
MEETING_BAAS_WEBHOOK_URL=
BOT_ATTENDEE_EMAIL=notetaker@yourdomain.com
# Dev uniquement : accepte les webhooks non signés (mettre 1). En prod, laisser vide.
ALLOW_UNSIGNED_WEBHOOK=
