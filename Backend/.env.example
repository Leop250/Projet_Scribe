GROQ_API_KEY="YOUR_KEY"
FRONTEND_URL="PUBLIC_URL"

# MeetingBaaS (Calendar API)
MEETING_BAAS_API_KEY="YOUR_KEY"
MEETING_BAAS_WEBHOOK_SECRET="whsec_..."
BOT_ATTENDEE_EMAIL="notetaker@yourdomain.com"

# Google OAuth (app à créer dans Google Cloud Console, scope Google Calendar,
# redirect URI = <BACKEND_URL>/calendar/oauth/callback)
GOOGLE_OAUTH_CLIENT_ID="YOUR_CLIENT_ID"
GOOGLE_OAUTH_CLIENT_SECRET="YOUR_CLIENT_SECRET"

# URL publique de ce backend (ngrok en dev, Railway en prod) : utilisée pour
# construire le lien de consentement inséré dans l'événement Google Calendar.
PUBLIC_BASE_URL="https://your-tunnel-or-domain"